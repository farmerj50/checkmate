{
  "name": "vipi-backend",
  "version": "1.0.0",
  "description": "Vipi Dating App Backend",
  "main": "dist/server.js",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.dev node_modules/tsx/dist/cli.mjs watch --clear-screen=false --exclude \"./dist/**\" --exclude \"./uploads/**\" src/server.ts",
    "build": "tsc --skipLibCheck",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "test": "npm run test:unit",
    "test:unit": "vitest run --config vitest.unit.config.mts",
    "test:integration": "vitest run --config vitest.config.mts",
    "start": "node dist/server.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset-demo": "tsx prisma/clear-demo-likes.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@prisma/client": "^5.9.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^4.22.3",
    "firebase-admin": "^14.5.1",
    "helmet": "^7.1.0",
    "multer": "^2.5.0",
    "openai": "^6.36.0",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "stripe": "^22.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/supertest": "^2.0.12",
    "js-yaml": "^5.4.2",
    "prisma": "^5.9.1",
    "socket.io-client": "^4.8.4",
    "supertest": "^6.3.3",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vite": "^7.3.8",
    "vitest": "^5.1.1"
  }
}
